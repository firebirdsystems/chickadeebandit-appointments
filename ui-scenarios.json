    {
      "name": "archiving takes a check-up off the list without losing it",
      "members": {
        "adult": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_appointments__appointments (id, person_id, kind, title, interval_months, next_due_date, lead_days, remind, remind_scope, visibility, status, created_by, created_at, updated_at) VALUES ('u-arch', 'seed-person', 'vision', ?, 24, '2030-03-14', 30, 1, 'household', 'household', 'active', 'seed', '2026-01-01T00:00:00.000Z', '2026-01-01T00:00:00.000Z')",
          "params": [
            "Old Eye Exam"
          ]
        },
        {
          "action": "open"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"appt-row\"]",
          "count": 1
        },
        {
          "action": "click",
          "selector": "[data-testid=\"edit-appointment\"]"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"appt-form\"]"
        },
        {
          "action": "select",
          "selector": "[data-testid=\"field-status\"]",
          "value": "archived"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"appt-submit\"]"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"appt-form\"]",
          "state": "detached"
        },
        {
          "action": "reload"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"appt-row\"]",
          "count": 0
        },
        {
          "action": "expectNoText",
          "text": "Old Eye Exam"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"toggle-archived\"]"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"appt-row\"]"
        },
        {
          "action": "expectText",
          "text": "Old Eye Exam",
          "selector": "[data-testid=\"appt-list\"]"
        }
      ]
    }
