      },
      "steps": [
        {
          "action": "open"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"add-appointment\"]"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"appt-form\"]"
        },
        {
